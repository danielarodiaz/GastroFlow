# App
APP_ENV=development
APP_SECRET_KEY=change-me-in-development
GOOGLE_MAPS_API_KEY=
STORE_NAME=Las Pizzas De Alejo
PIZZERIA_WHATSAPP_PHONE=
TRANSFER_TITULAR=Alvaro Alejo Marquez
TRANSFER_ALIAS=marquezale.uala
BRAND_LOGO_URL=

# Reflex
REFLEX_APP_NAME=gastroflow
REFLEX_FRONTEND_PORT=3000

# Database
POSTGRES_DB=gastroflow
POSTGRES_USER=gastroflow
POSTGRES_PASSWORD=gastroflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://gastroflow:gastroflow@localhost:5433/gastroflow

# Media storage
# local: guarda en el filesystem local de Reflex.
# supabase: sube a un bucket publico de Supabase Storage.
MEDIA_STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=gastroflow-media
