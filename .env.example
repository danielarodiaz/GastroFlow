# App
APP_ENV=development
APP_SECRET_KEY=change-me-in-development
GOOGLE_MAPS_API_KEY=
STORE_NAME=Las Pizzas De Alejo
PIZZERIA_WHATSAPP_PHONE=
TRANSFER_TITULAR=Alvaro Alejo Marquez
TRANSFER_ALIAS=marquezale.uala
BRAND_LOGO_URL=

# Reflex
REFLEX_APP_NAME=gastroflow
REFLEX_FRONTEND_PORT=3000

# Database local
POSTGRES_DB=gastroflow
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://user:password@localhost:5433/gastroflow

# Database Supabase
POSTGRES_DB=postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres?sslmode=require

# Media storage
# local: guarda en el filesystem local de Reflex.
# supabase: sube a un bucket publico de Supabase Storage.
MEDIA_STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=gastroflow-media

# OCR local (activo por defecto, sin servicios pagos)
EXPENSE_OCR_ENGINE=tesseract
TESSERACT_LANGUAGE=spa

# Azure Document Intelligence (opcional para el futuro)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-invoice
